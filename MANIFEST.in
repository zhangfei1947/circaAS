include README.md CHANGELOG.md
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests *.py
prune validation
include validation/VALIDATION.md validation/RESULTS.md validation/published_summary.json
include validation/check_run.py validation/check_coverage_catalog.py validation/make_validation_panel.py
prune dist
prune release-dist
global-exclude __pycache__ *.py[cod] .DS_Store
